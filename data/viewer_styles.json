  "_zeroIsMissingComment": "シェープファイル化の際に空欄が 0 で埋められた列。PH は64.7%、FE は64.6%、CL は57.9% が 0 なので、ポップアップでは注記を添える。",
  "zeroIsMissing": [
    "HEIGHT", "SC", "SCL", "NWL_01", "PWL_01", "Q_01", "QSP_01",
    "PH", "NOX", "NH4_N", "CL", "ER", "HD", "FE", "SO4", "KMNO4", "DR", "CA", "MG", "AL"
  ],

  "_dateFieldsComment": "YYYYMMDD の文字列。00000000 / 0 は未測定のプレースホルダ。",
  "dateFields": ["START", "FINISH", "NWLD_01", "NWLD_02", "PWLD_01", "PWLD_02", "QD_01", "QD_02", "QSPD_01"],

  "popupOrder": [
    "PREF_NAME", "ADR", "MUNI_CD", "NEN", "USE", "DEP", "HEIGHT",
    "POS_QUALITY", "POS_N", "ADR_DIST_KM", "LAT", "LON",
    "START", "FINISH", "DD", "DIA", "SC", "SCL", "SCD",
    "NWLD_01", "NWL_01", "NWLD_02", "NWL_02",
    "PWLD_01", "PWL_01", "PWLD_02", "PWL_02",
